  "faq": {
    "heading": "Frequently Asked Questions",
    "subheading": "Answers to the most common questions",
    "items": [
      {
        "question": "How do I get started with the platform?",
        "answer": "Create your account, choose the right plan, and start managing your clinic with ease. Everything you need is in one place."
      },
      {
        "question": "Is my data safe and secure?",
        "answer": "Yes. Your data is protected using modern security and encryption standards. Your privacy and your patients' privacy are our priority."
      },
      {
        "question": "Can I use the platform on mobile?",
        "answer": "Yes. The platform works on mobile, tablet, and desktop. Access it anytime, anywhere."
      },
      {
        "question": "What payment methods are available?",
        "answer": "We offer secure and convenient payment options. Simply choose the method that works best for you during checkout."
      },
      {
        "question": "Can I cancel my subscription at any time?",
        "answer": "Yes. You can cancel your subscription at any time. Your plan won't renew after cancellation."
      }
    ]
  },
